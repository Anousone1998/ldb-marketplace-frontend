# Cloudflare Pages response headers.
# Everything must be revalidated on each load so a deploy shows up at once…
/*
  Cache-Control: no-cache

# …except Vite's content-hashed build files, which never change under the same name.
# "! Cache-Control" drops the rule above first; otherwise Pages joins both values with a comma.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  ! Cache-Control
  Cache-Control: public, max-age=86400

# Read by the app to detect a new deploy (src/composables/useAppUpdate.js)
/version.json
  ! Cache-Control
  Cache-Control: no-store
